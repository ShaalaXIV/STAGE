<ContentDialog
    x:Class="STAGE.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    x:Uid="SettingsDlg"
    Title="Settings"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    PrimaryButtonClick="OkButton_Click"
    DefaultButton="Primary"
    MinWidth="840"
    MaxWidth="920"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    FullSizeDesired="False">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">840</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">920</x:Double>
    </ContentDialog.Resources>

    <Grid Width="820" Height="570">
    <TabView x:Name="SettingsTabView"
             IsAddTabButtonVisible="False"
             TabWidthMode="Equal">

        <TabViewItem Header="Mod Folders" IsClosable="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" Padding="4,12,16,12">
                    <TextBlock Text="Managed Mod Folders"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Choose which Penumbra mods S.T.A.G.E. can manage, then select the active mod."
                               TextWrapping="Wrap"
                               Opacity="0.72"/>

                    <ListBox x:Name="ManagedModFoldersListBox"
                             MinHeight="180"
                             MaxHeight="260"
                             SelectionChanged="ManagedModFoldersListBox_SelectionChanged"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Add Folder"
                                Click="AddManagedModFolderButton_Click"/>
                        <Button Content="Remove Selected"
                                Click="RemoveManagedModFolderButton_Click"/>
                    </StackPanel>

                    <TextBlock Text="Selected active mod"
                               Margin="0,8,0,0"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="DirectoryPathTextBox"
                             IsReadOnly="True"
                             TextChanged="DirectoryPathTextBox_TextChanged"/>

                    <CheckBox x:Name="AutoReloadCheckBox"
                              x:Uid="AutoReloadCheckBox"
                              Content="Automatically reload the active mod after changes"
                              IsChecked="True"
                              Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>

        <TabViewItem Header="Audio" IsClosable="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" Padding="4,12,16,12">
                    <TextBlock Text="Audio Defaults"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Configure the baseline sound, conversion template, volume, and batch EQ behavior."
                               TextWrapping="Wrap"
                               Opacity="0.72"/>

                    <TextBlock x:Uid="BaselineScdLabel"
                               Text="Baseline SCD key (e.g. sound/bpmloop.scd)"
                               Margin="0,8,0,0"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="BaselineScdTextBox"
                             TextChanged="BaselineScdTextBox_TextChanged"/>

                    <TextBlock x:Uid="DefaultScdTemplateLabel"
                               Text="Default SCD template file"
                               Margin="0,8,0,0"
                               FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DefaultScdTemplateTextBox" Grid.Column="0"/>
                        <Button x:Uid="BrowseDefaultScdTemplateButton"
                                Grid.Column="1"
                                Content="Browse"
                                Click="BrowseDefaultScdTemplateButton_Click"/>
                    </Grid>

                    <TextBlock x:Uid="ScdAudioVolumeLabel"
                               Text="SCD Audio Volume (Soundy scale: 1.0 to 5.0)"
                               Margin="0,8,0,0"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="1.0 keeps the original level; 5.0 maps to 3.5x gain. A limiter protects converted audio from clipping."
                               TextWrapping="Wrap"
                               Opacity="0.72"/>
                    <NumberBox x:Name="ScdAudioVolumeBox"
                               Minimum="1"
                               Maximum="5"
                               SpinButtonPlacementMode="Inline"
                               SmallChange="0.1"/>
                    <CheckBox x:Name="NormalizeVolumeCheckBox"
                              x:Uid="NormalizeVolumeCheckBox"
                              Content="Normalize volume during conversion"/>

                    <TextBlock Text="Batch EQ preset"
                               Margin="0,8,0,0"
                               FontWeight="SemiBold"/>
                    <ComboBox x:Name="ConvertAllEqPresetComboBox"
                              HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Batch audio conversion"
                               Margin="0,12,0,0"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Apply the current donor SCD or the selected volume and EQ preset to every track."
                               TextWrapping="Wrap"
                               Opacity="0.72"/>
                    <Button x:Name="ConvertAllToDefaultScdButton"
                            Content="Convert All Tracks to Current default.scd"
                            Click="ConvertAllToDefaultScdButton_Click"
                            HorizontalAlignment="Stretch"/>
                    <Button x:Name="ConvertAllToEqPresetButton"
                            Content="Convert All Tracks to Selected EQ Preset"
                            Click="ConvertAllToEqPresetButton_Click"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>

        <TabViewItem Header="Animation" IsClosable="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" Padding="4,12,16,12">
                    <TextBlock Text="PAP Import Defaults"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Choose a known-good donor PAP whose compatible non-sound TMB tracks will be copied into single-loop PAP imports."
                               TextWrapping="Wrap"
                               Opacity="0.72"/>

                    <TextBlock Text="Default donor PAP"
                               Margin="0,8,0,0"
                               FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DefaultDonorPapTextBox"
                                 Grid.Column="0"
                                 PlaceholderText="Leave blank to use the built-in Bees Knees TMB setup"/>
                        <Button Grid.Column="1"
                                Content="Browse"
                                Click="BrowseDefaultDonorPapButton_Click"/>
                    </Grid>
                    <TextBlock Text="The donor is preselected in the PAP import window and can still be replaced for an individual import. Sound-reference tracks are not copied."
                               TextWrapping="Wrap"
                               Opacity="0.65"/>

                    <TextBlock Text="PAP Maintenance"
                               Margin="0,14,0,0"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Keep each PAP's animation-only and expression tracks, remove its other TMB tracks, then insert the configured donor layout."
                               TextWrapping="Wrap"
                               Opacity="0.72"/>
                    <Button x:Name="ApplyDonorLayoutToAllPapsButton"
                            Content="Apply Donor TMB Layout to All PAPs"
                            Click="ApplyDonorLayoutToAllPapsButton_Click"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>

        <TabViewItem Header="Appearance" IsClosable="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" Padding="4,12,16,12">
                    <TextBlock Text="Appearance"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Customize the main S.T.A.G.E. window."
                               TextWrapping="Wrap"
                               Opacity="0.72"/>

                    <TextBlock x:Uid="BackgroundImageLabel"
                               Text="Background image"
                               Margin="0,8,0,0"
                               FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BackgroundImageTextBox" Grid.Column="0"/>
                        <Button x:Uid="BrowseBackgroundButton"
                                Grid.Column="1"
                                Content="Browse"
                                Click="BrowseBackgroundButton_Click"/>
                    </Grid>
                    <TextBlock Text="PNG, JPG, BMP, and GIF images are supported."
                               TextWrapping="Wrap"
                               Opacity="0.65"/>
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>

        <TabViewItem Header="Updates" IsClosable="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" Padding="4,12,16,12">
                    <TextBlock Text="Download Dependencies"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="S.T.A.G.E. uses yt-dlp and FFmpeg for YouTube downloads and audio preparation."
                               TextWrapping="Wrap"
                               Opacity="0.72"/>

                    <CheckBox x:Name="AutoUpdateDependenciesCheckBox"
                              Content="Automatically update yt-dlp and FFmpeg before YouTube downloads"
                              IsChecked="True"
                              Margin="0,8,0,0"/>
                    <Button Content="Check and Update Dependencies Now"
                            Click="UpdateDependenciesButton_Click"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>

        <TabViewItem Header="Maintenance" IsClosable="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" Padding="4,12,16,12">
                    <TextBlock Text="Library Maintenance"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="These tools make broad changes to the active mod. Review each confirmation before continuing."
                               TextWrapping="Wrap"
                               Opacity="0.72"/>

                    <Button x:Uid="OrganizeLibraryButton"
                            Content="Organize Library"
                            Click="OrganizeLibraryButton_Click"
                            HorizontalAlignment="Stretch"
                            Margin="0,8,0,0"/>

                    <Button Content="Cleanup Missing Tracks / VFX / PAP"
                            Click="CleanupMissingReferencesButton_Click"
                            HorizontalAlignment="Stretch"/>

                    <Button x:Name="SynchronizeAssetFilenamesButton"
                            Content="Synchronize PAP / VFX Filenames"
                            Click="SynchronizeAssetFilenamesButton_Click"
                            HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Backup and restore"
                               Margin="0,12,0,0"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Full mod backups are stored outside the Penumbra mod folder."
                               TextWrapping="Wrap"
                               Opacity="0.72"/>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Keep automatic backups for"
                                   VerticalAlignment="Center"/>
                        <NumberBox x:Name="AutoBackupRetentionDaysBox"
                                   Grid.Column="1"
                                   Minimum="1"
                                   Maximum="3650"
                                   SpinButtonPlacementMode="Inline"/>
                        <TextBlock Grid.Column="2"
                                   Text="days (manual backups are never deleted)"
                                   VerticalAlignment="Center"
                                   Opacity="0.72"/>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BackupModButton"
                                Grid.Column="0"
                                Content="Backup Active Mod"
                                Click="BackupModButton_Click"
                                HorizontalAlignment="Stretch"/>
                        <Button x:Name="RestoreModButton"
                                Grid.Column="1"
                                Content="Restore Mod Backup"
                                Click="RestoreModButton_Click"
                                HorizontalAlignment="Stretch"/>
                    </Grid>
                    <Button x:Name="CleanupExpiredAutoBackupsButton"
                            Content="Delete Expired Automatic Backups Now"
                            Click="CleanupExpiredAutoBackupsButton_Click"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>
    </TabView>

    <Grid x:Name="SettingsBusyOverlay"
          Visibility="Collapsed"
          IsHitTestVisible="True"
          Background="#B31A1A1A">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="360"
                Padding="22"
                CornerRadius="12"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                Background="#F0202020">
            <StackPanel Spacing="15">
                <TextBlock Text="Please Wait"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <Image x:Name="SettingsBusyImage"
                       Width="80"
                       Height="80"
                       HorizontalAlignment="Center"
                       Stretch="Uniform"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <media:RotateTransform x:Name="SettingsBusyRotate"/>
                    </Image.RenderTransform>
                </Image>
                <TextBlock x:Name="SettingsBusyLabel"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="WrapWholeWords"/>
                <ProgressBar x:Name="SettingsBusyProgressBar"
                             Height="14"
                             IsIndeterminate="True"/>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</ContentDialog>
