<ContentDialog
    x:Class="STAGE.YouTubeDownloadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Songs From a Link"
    PrimaryButtonText="Download"
    CloseButtonText="Close"
    PrimaryButtonClick="DownloadButton_Click"
    DefaultButton="Primary">

    <StackPanel Spacing="8" MinWidth="480">

        <TextBlock Text="YouTube or SoundCloud URL:"/>
        <TextBox x:Name="UrlTextBox" PlaceholderText="https://youtube.com/... or https://soundcloud.com/..."/>

        <TextBlock x:Uid="ModeLabel" Text="Mode:"/>
        <ComboBox x:Name="ModeComboBox" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="ModeComboBox_SelectionChanged">
            <ComboBoxItem x:Uid="SingleTrackItem" Content="Single Track"/>
            <ComboBoxItem x:Uid="PlaylistItem" Content="Playlist"/>
        </ComboBox>

        <TextBlock x:Uid="TargetPlaylistLabel" Text="Target Playlist:"/>
        <ComboBox x:Name="TargetPlaylistComboBox" HorizontalAlignment="Stretch"/>

        <TextBlock Text="Browser cookies"/>
        <ComboBox x:Name="CookieBrowserComboBox" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Automatic (use saved sign-in only when required)"/>
            <ComboBoxItem Content="Firefox"/>
            <ComboBoxItem Content="Chrome"/>
            <ComboBoxItem Content="Microsoft Edge"/>
        </ComboBox>
        <TextBlock Text="Automatic mode uses cookies received from the VRCVideoCacher Cookies Exporter only after YouTube requests sign-in. Direct browser access remains available, but Chrome/Edge may be blocked by Windows cookie encryption."
                   Opacity="0.7" TextWrapping="Wrap"/>

        <TextBlock Text="SoundCloud account"/>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="SoundCloudSignInButton" Content="Sign in to SoundCloud" Click="SoundCloudSignInButton_Click" HorizontalAlignment="Stretch"/>
            <Button x:Name="SoundCloudSignOutButton" Grid.Column="1" Content="Sign out" Click="SoundCloudSignOutButton_Click" HorizontalAlignment="Stretch"/>
        </Grid>
        <TextBlock x:Name="SoundCloudStatusText" TextWrapping="Wrap" Opacity="0.7"/>

        <TextBlock Text="Equalizer preset"/>
        <ComboBox x:Name="PresetComboBox" HorizontalAlignment="Stretch"/>

        <TextBlock Text="Volume"/>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="55"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="VolumeSlider" Minimum="1" Maximum="5" StepFrequency="0.1"
                    ValueChanged="VolumeSlider_ValueChanged"/>
            <TextBlock Grid.Column="1" x:Name="VolumeValueLabel" VerticalAlignment="Center"
                       TextAlignment="Right" Text="1.5"/>
        </Grid>

        <ProgressBar x:Name="ProgressBar1" Minimum="0" Maximum="100" Value="0" Height="16" Margin="0,8,0,0"/>
        <TextBlock x:Name="StatusLabel" Text="" TextWrapping="Wrap"/>

    </StackPanel>
</ContentDialog>
